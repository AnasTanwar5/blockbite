{
  "name": "blockbite-backend",
  "version": "1.0.0",
  "description": "Express REST API & Blockchain Sync Engine for BLOCKBITE Decentralized Food Delivery",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:instance1": "cross-env INSTANCE=1 nodemon index.js",
    "dev:instance2": "cross-env INSTANCE=2 nodemon index.js",
    "dev:instance3": "cross-env INSTANCE=3 nodemon index.js",
    "seed": "node seed.js",
    "seed:instance1": "node seed.js --instance=1",
    "seed:instance2": "node seed.js --instance=2",
    "seed:instance3": "node seed.js --instance=3",
    "seed:reset": "node seed.js --reset"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
